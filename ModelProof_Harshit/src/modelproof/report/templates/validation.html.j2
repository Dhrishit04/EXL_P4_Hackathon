{% extends "base.html.j2" %}{% block content %}<p class="badge">{{ report.rating }}</p><p>Generated {{ report.created_at }}</p>{% for heading, text in report.narrative.items() %}<h2>{{ heading }}</h2><p>{{ text }}</p>{% endfor %}
{% for area, tests in report.results.tests|groupby('area') %}<h2>{{ area }}</h2><table><tr><th>Test</th><th>Value</th><th>Policy threshold</th><th>RAG</th><th>Principle</th></tr>{% for row in tests %}<tr><td>{{ row.test }}</td><td>{{ row.value if row.value is not none else 'Unavailable' }}</td><td>{{ row.threshold }}</td><td class="{{ row.rag }}">{{ row.rag }}</td><td>{{ row.ss123_principle }}</td></tr>{% endfor %}</table>{% endfor %}
{% for title, data in images.items() %}<figure><img alt="{{ title }}" src="data:image/png;base64,{{ data }}"><figcaption>{{ title }}</figcaption></figure>{% endfor %}
{% for name, rows in report.results.tables.items() %}{% if rows %}<h2>{{ name }}</h2><table><thead><tr>{% for key in rows[0].keys() %}<th>{{ key }}</th>{% endfor %}</tr></thead><tbody>{% for row in rows %}<tr>{% for value in row.values() %}<td>{{ value }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>{% endif %}{% endfor %}
<h2>Findings</h2>{% for row in report.findings %}<article><h3>{{ row.id }} — {{ row.severity }} — {{ row.status }}</h3><p>{{ row.description }}</p><p>{{ row.recommendation }}</p><p>Evidence {{ row.evidence_ids|join(', ') }} · {{ row.ss123_principle }}</p></article>{% else %}<p>No findings recorded.</p>{% endfor %}
<h2>Review and sign off</h2>{% for row in approvals %}<p>{{ row.ts }} — {{ row.reviewer }} — {{ row.gate }} — {{ row.decision }}{% if row.auto %} — auto (demo flag){% endif %}</p><p>{{ row.comment }}</p>{% else %}<p>No approval recorded in the audit log.</p>{% endfor %}{% endblock %}
