# Copy to .env (never commit .env). Varun shares the runtime LLM key privately.
LLM_PROVIDER=anthropic          # anthropic | openai | azure_openai | google_genai
LLM_MODEL=claude-sonnet-5-5     # model id (azure_openai: also set AZURE_OPENAI_DEPLOYMENT)
LLM_MODE=auto                   # auto (replay on cache hit, else live+record) | live | record | replay

# Provider keys (set only the one you use)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# OPENAI_BASE_URL=            # OpenAI compatible endpoints, e.g. GitHub Models

MLFLOW_TRACKING_URI=sqlite:///mlflow.db
RSCRIPT=Rscript
MODELPROOF_ARTIFACTS=artifacts
# MODELPROOF_RUN_ID=            # optional; defaults to a timestamp
