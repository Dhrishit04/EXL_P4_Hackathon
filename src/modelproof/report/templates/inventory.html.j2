{% extends "base.html.j2" %}{% block content %}<table><thead><tr><th>Model</th><th>Name</th><th>Tier</th><th>Status</th><th>Documentation</th><th>Drifts</th><th>Security flags</th></tr></thead><tbody>{% for row in rows %}<tr><td>{{ row.model_id }}</td><td>{{ row.name }}</td><td>{{ row.risk_tier }}</td><td>{{ row.status }}</td><td>{{ row.documentation_status }}</td><td>{{ row.doc_code_drifts|length }}</td><td>{{ row.security_flags|length }}</td></tr>{% endfor %}</tbody></table>{% endblock %}
