<!doctype html><html lang="en"><head><meta charset="utf-8"><title>{{ title }} — {{ model_id }}</title>
<style>
@page {size:A4; margin:18mm} body{font:14px/1.5 Arial,sans-serif;color:#15324f;max-width:1000px;margin:32px auto;padding:0 20px}h1{border-bottom:3px solid #dd7826}h2{margin-top:28px}table{border-collapse:collapse;width:100%;font-size:12px}th,td{border:1px solid #d6dce1;padding:7px;text-align:left;vertical-align:top;overflow-wrap:anywhere}th{background:#edf1f5}.green,.PASS{color:#24784b}.amber,.unsupported{background:#fff1cc}.red,.FAIL,.contradicted{color:#b93232}.badge{font-size:22px;font-weight:bold}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f1f3f5;padding:10px}img{max-width:100%}figure{margin:20px 0}tr,figure{break-inside:avoid}dt{font-weight:bold}dd{margin-bottom:12px}@media print{body{margin:0;padding:0}.no-print{display:none}thead{display:table-header-group}}
