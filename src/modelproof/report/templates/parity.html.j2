{% extends "base.html.j2" %}{% block content %}<p class="badge {{ cert.overall }}">{{ cert.overall }}</p><p>Run {{ cert.run_id }} · attempt {{ cert.attempt }} · {{ cert.created_at }}</p>
<table><tr><th>Level</th><th>Test</th><th>Metric</th><th>Value</th><th>Tolerance</th><th>Result</th></tr>{% for row in cert.levels %}<tr><td>{{ row.level }}</td><td>{{ row.name }}</td><td>{{ row.metric }}</td><td>{{ row.value }}</td><td>{{ row.tolerance }}</td><td>{{ 'PASS' if row.passed else 'FAIL' }}</td></tr>{% endfor %}</table>
<h2>Hashes and runtime versions</h2><pre>{{ cert.hashes|tojson(indent=2) }}</pre><pre>{{ cert.versions|tojson(indent=2) }}</pre><h2>Mismatch summary</h2><pre>{{ cert.mismatch_summary|tojson(indent=2) }}</pre><h2>Attempt history</h2>{% for attempt in attempts %}<p>Attempt {{ attempt.attempt }} — {{ attempt.overall }} — {{ attempt.created_at }}</p>{% else %}<p>No saved attempt certificates.</p>{% endfor %}{% endblock %}
